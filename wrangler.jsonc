{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chugchug-interactive-demo",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-13",
  "containers": [
    {
      "class_name": "ChugChugContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./Dockerfile.demo"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHUGCHUG_CONTAINER",
        "class_name": "ChugChugContainer"
      }
    ]
  },
  "exports": {
    "ChugChugContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://chugchug-preview.smooks.co.uk"
  }
}
